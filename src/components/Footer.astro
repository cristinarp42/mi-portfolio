    <button
      id="email-copy-btn"
      class="group inline-flex items-center justify-center gap-2.5 px-5 py-4 md:py-2 rounded-full border border-stone-700 hover:border-[var(--color-accent)] bg-stone-800/60 hover:bg-[var(--color-accent)]/10 transition-all cursor-pointer w-full sm:w-auto"
      data-email="hola@crodriguezperez.com"
      aria-label="Copiar correo electrónico"
    >
      <span class="text-xs font-semibold text-stone-200 group-hover:text-[var(--color-accent)] transition-colors whitespace-nowrap">
        hola@crodriguezperez.com
      </span>
      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="text-stone-400 group-hover:text-[var(--color-accent)] transition-colors flex-none">
        <rect x="9" y="9" width="12" height="12" rx="2"/>
        <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/>
      </svg>
    </button>
  </div>

  <!-- EXTREMOS: Redes a la izquierda y Copyright a la derecha (Fila inferior en móvil, separados en desktop) -->
  <div class="order-2 md:order-1 py-5 flex items-center justify-between w-full md:w-auto md:contents">
    
    <!-- Redes Sociales (Izquierda en móvil y desktop) -->
    <div class="flex items-center gap-2 flex-none md:order-1">
      <a href="https://github.com/tuusuario" aria-label="GitHub" class="w-8 h-8 border border-stone-700 rounded-md flex items-center justify-center text-stone-300 hover:bg-[var(--color-accent)] hover:border-[var(--color-accent)] hover:text-white transition-colors">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M9 19c-4.3 1.4-4.3-2.5-6-3m12 5v-3.5c0-1 .1-1.4-.5-2 2.8-.3 5.5-1.4 5.5-6a4.6 4.6 0 0 0-1.3-3.2 4.2 4.2 0 0 0-.1-3.2s-1.1-.3-3.5 1.3a12.3 12.3 0 0 0-6.2 0C6.5 2.8 5.4 3.1 5.4 3.1a4.2 4.2 0 0 0-.1 3.2A4.6 4.6 0 0 0 4 9.5c0 4.6 2.7 5.7 5.5 6-.6.6-.6 1.2-.5 2V21"/>
        </svg>
      </a>
      <a href="https://linkedin.com/in/tuusuario" aria-label="LinkedIn" class="w-8 h-8 border border-stone-700 rounded-md flex items-center justify-center text-stone-300 hover:bg-[var(--color-accent)] hover:border-[var(--color-accent)] hover:text-white transition-colors">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6Z"/>
          <rect x="2" y="9" width="4" height="12"/>
          <circle cx="4" cy="4" r="2"/>
