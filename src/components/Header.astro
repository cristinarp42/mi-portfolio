<header class="relative w-full px-4 sm:px-8 py-5 flex items-center justify-between border-b border-stone-100">

  <!-- IZQUIERDA: Logo + tagline -->
  <a href="/" class="group flex items-center gap-4 z-20">
    <img 
      src="/logo.svg" 
      alt="Logo" 
      class="h-8 w-auto flex-none opacity-80"
    />

    <div class="flex flex-col items-start justify-center leading-tight">
      <span class="text-[10px] uppercase tracking-wider text-stone-400 font-medium group-hover:text-[var(--color-accent)] transition-colors whitespace-nowrap">
        Marketing &amp;
      </span>
      <span class="text-[10px] uppercase tracking-wider text-stone-400 font-medium group-hover:text-[var(--color-accent)] transition-colors whitespace-nowrap">
        Desarrollo Web
      </span>
    </div>
  </a>

  <!-- BOTÓN HAMBURGUESA (Móvil) -->
  <button id="menu-toggle" aria-label="Abrir menú" class="md:hidden z-20 text-stone-600 hover:text-[var(--color-accent)] focus:outline-none p-1">
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <line x1="3" y1="12" x2="21" y2="12"></line>
      <line x1="3" y1="6" x2="21" y2="6"></line>
      <line x1="3" y1="18" x2="21" y2="18"></line>
    </svg>
  </button>

  <!-- DERECHA: Navegación -->
<nav id="menu" class="hidden md:flex absolute md:static top-full md:top-auto left-0 right-0 bg-white md:bg-transparent shadow-lg md:shadow-none p-6 md:p-0 flex-col md:flex-row items-center gap-6 sm:gap-10 text-sm font-medium text-stone-600 tracking-wide z-10">
  <a href="/" class="hover:text-[var(--color-accent)] transition-colors">home</a>
  <a href="#proyectos" class="hover:text-[var(--color-accent)] transition-colors">proyectos</a>
  <a href="/sobre-mi" class="hover:text-[var(--color-accent)] transition-colors">sobre mí</a>
  <a href="#curriculum" class="hover:text-[var(--color-accent)] transition-colors">currículum</a>
</nav>

</header>

<script>
  const menuToggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('menu');

  if (menuToggle && menu) {
    menuToggle.addEventListener('click', () => {
      menu.classList.toggle('hidden');
      menu.classList.toggle('flex');
    });
  }
</script>