---
// src/components/JardinCarrusel.astro
import { getCollection } from 'astro:content';

const todosLosProyectos = await getCollection('proyectos');
const proyectos = todosLosProyectos.filter(p => p.id !== 'portfolio');
proyectos.sort((a, b) => a.data.orden - b.data.orden);

const proyectosData = proyectos.map((p) => ({
  id: p.id,
  titulo: p.data.titulo,
  subtituloBreve: p.data.subtituloBreve,
  categoria: p.data.categoria,
  ilustracion: p.data.ilustracion || '',
  ilustracionSprite: p.data.ilustracionSprite || '',
  spriteFrames: p.data.spriteFrames || 4,
  animacionLottie: p.data.animacionLottie || '',
  imagenDestacada: p.data.imagenDestacada || ''
}));
---

<div id="carrusel-container" class="relative w-full max-w-5xl mx-auto pt-0 pb-4 md:py-2 px-4 select-none touch-pan-y">
  <!-- LÍNEA DE TIERRA ASCII (Detrás de los elementos) -->
  <div 
    id="ascii-ground-container" 
    class="absolute w-[95%] top-[45%] md:top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 z-0 pointer-events-none"
  ></div>

  <!-- Contenedor Principal: 1 Columna en móvil, 3 en Desktop -->
  <div class="relative z-10 grid grid-cols-1 md:grid-cols-3 items-center gap-6 min-h-0">
    
    <!-- Slot 0: Planta Izquierda (Oculta en Móvil) -->
    <div id="slot-0" class="hidden md:flex justify-center items-center relative z-10 -translate-y-6 origin-bottom">
      <!-- Inyectado por JS -->
    </div>

    <!-- Slot 1: Planta Central + Tarjeta Transparente -->
    <div class="relative flex justify-center items-center z-30 translate-y-5 md:translate-y-5">
      <!-- Tarjeta Central (100% Transparente) -->
      <div id="slot-1" class="w-full flex justify-center items-center origin-bottom">
        <!-- Inyectado por JS -->
      </div>
    </div>

    <!-- Slot 2: Planta Derecha (Oculta en Móvil) -->
    <div id="slot-2" class="hidden md:flex justify-center items-center relative z-10 -translate-y-5 origin-bottom">
      <!-- Inyectado por JS -->
    </div>

  </div>

  <!-- Puntos Indicadores (Dots) -->
  <div id="carrusel-dots" class="flex items-center justify-center gap-1.5 mt-10 z-20 relative">
    <!-- Inyectado por JS -->
  </div>

  <!-- Botones Prev / Next -->
  <button
    id="btn-prev"
    aria-label="Proyecto anterior"
    class="hidden md:flex absolute left-3 bottom-3 z-40 w-10 h-10 border border-stone-300 bg-white rounded-md hover:bg-[var(--color-accent)] hover:border-[var(--color-accent)] hover:text-white transition-colors items-center justify-center text-stone-700 opacity-0 cursor-pointer"
  >
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M15 18l-6-6 6-6"/>
    </svg>
  </button>

  <button
    id="btn-next"
    aria-label="Siguiente proyecto"
    class="hidden md:flex absolute right-3 bottom-3 z-40 w-10 h-10 border border-stone-300 bg-white rounded-md hover:bg-[var(--color-accent)] hover:border-[var(--color-accent)] hover:text-white transition-colors items-center justify-center text-stone-700 opacity-0 cursor-pointer"
  >
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M9 18l6-6-6-6"/>
    </svg>
  </button>

</div>

<!-- Estilos para la línea ASCII y el sprite -->
<style>
  :global(.ascii-ground) {
    font-family: ui-monospace, 'Cascadia Code', 'Source Code Pro', Menlo, Consolas, monospace;
    color: #b1b2b6;
    white-space: pre;
    overflow: hidden;
    text-align: center;
    width: 100%;
    display: block;
    user-select: none;
    line-height: 1;
    font-size: 1.1rem;
    letter-spacing: -0.05em;
  }

  :global(#carrusel-container:hover #btn-prev),
  :global(#carrusel-container:hover #btn-next) {
    opacity: 1;
  }

  /* Sprite de la planta animada */
  :global(.planta-sprite) {
    background-repeat: no-repeat;
    background-position: 0% 0%;
    background-size: calc(var(--frames) * 100%) 100%;
  }

  /* 1. Animación al pasar el ratón (Hover) */
  :global(.group:hover .planta-sprite:not(.is-clicking)),
  :global(.planta-sprite.animate-sprite:not(.is-clicking)) {
    animation: planta-sprite-play 0.6s steps(var(--steps, 3)) forwards;
  }

  /* 2. Animación activada por clic (reproduce forzadamente desde el frame 0) */
  :global(.planta-sprite.play-triggered) {
    animation: planta-sprite-play 0.6s steps(var(--steps, 3)) forwards !important;
  }

  @keyframes planta-sprite-play {
    from { background-position: 0% 0%; }
    to   { background-position: 100% 0%; }
  }

  /* Perspectiva para la animación demo en móvil */
  .perspective-card {
    perspective: 1000px;
  }

  .demo-flip-container {
    transition: transform 0.8s cubic-bezier(0.4, 0, 0.2, 1);
    transform-style: preserve-3d;
  }

  .demo-flip-container.is-demo-flipped {
    transform: rotateY(180deg);
  }

  .group.hover-simulated {
    background-color: rgb(28 25 23) !important;
    border-color: rgb(44 40 37) !important;
  }

  .group.hover-simulated .z-0 {
    opacity: 1 !important;
  }

  .group.hover-simulated .w-80 {
    opacity: 0 !important;
    pointer-events: none !important;
  }

  .group.hover-simulated span,
  .group.hover-simulated div {
    color: #fff !important;
    border-color: rgb(44 40 37) !important;
  }
</style>

<!-- Script del Carrusel, Gestos y Autoplay -->
<script is:inline define:vars={{ proyectosData }}>
  let currentIndex = 0;
  const total = proyectosData.length;
  let autoplayTimer = null;

  const carruselContainer = document.getElementById('carrusel-container');
  const slot0 = document.getElementById('slot-0');
  const slot1 = document.getElementById('slot-1');
  const slot2 = document.getElementById('slot-2');
  const dotsContainer = document.getElementById('carrusel-dots');
  const btnPrev = document.getElementById('btn-prev');
  const btnNext = document.getElementById('btn-next');

  function getProject(index) {
    const normIndex = (index % total + total) % total;
    return proyectosData[normIndex];
  }

  function renderIlustracion(project, isCenter = false) {
    const steps = (project.spriteFrames || 4) - 1;
    const activeClass = isCenter ? 'animate-sprite' : '';

    if (project.ilustracionSprite) {
      return `<div class="planta-sprite h-full aspect-[2/3] pointer-events-none ${activeClass}" style="background-image:url('${project.ilustracionSprite}'); --frames:${project.spriteFrames}; --steps:${steps};"></div>`;
    }
    if (project.ilustracion) {
      return `<img src="${project.ilustracion}" alt="${project.titulo}" class="w-full h-full object-contain pointer-events-none" />`;
    }
    return `<span class="text-4xl">🪴</span>`;
  }

  function renderDots() {
    if (!dotsContainer) return;
    const activeIndex = (currentIndex % total + total) % total;
    
    dotsContainer.innerHTML = proyectosData.map((_, i) => `
      <button
        data-dot="${i}"
        aria-label="Ir al proyecto ${i + 1}"
        class="h-2 rounded-full transition-all cursor-pointer ${
          i === activeIndex
            ? 'bg-[var(--color-accent)] w-6'
            : 'bg-stone-300 hover:bg-stone-400 w-2'
        }"
      ></button>
    `).join('');

    dotsContainer.querySelectorAll('[data-dot]').forEach(dot => {
      dot.addEventListener('click', () => {
        currentIndex = parseInt(dot.getAttribute('data-dot'), 10);
        renderCarousel();
        resetAutoplay();
      });
    });
  }

  function renderCarousel() {
    if (!total) return;

    const leftProject = getProject(currentIndex - 1);
    const centerProject = getProject(currentIndex);
    const rightProject = getProject(currentIndex + 1);

    // Slot 0 (Izquierda)
    if (slot0) {
      slot0.innerHTML = `
        <a href="/proyectos/${leftProject.id}" class="slot-lateral-link group block cursor-pointer transition-transform duration-300 hover:scale-105">
          <div class="w-60 h-60 flex items-center justify-center">
            ${renderIlustracion(leftProject, false)}
          </div>
        </a>
      `;
    }

    // Slot 1 (Centro)
    if (slot1) {
      slot1.innerHTML = `
        <div class="perspective-card w-full max-w-xs">
          <div id="demo-card-wrapper" class="demo-flip-container w-full">
            
            <a href="/proyectos/${centerProject.id}" id="card-center-link" class="group relative block w-full bg-transparent border border-stone-300 rounded-xl transition-all duration-500 hover:bg-stone-900 hover:border-stone-800 hover:shadow-2xl cursor-pointer overflow-hidden">

              ${centerProject.imagenDestacada ? `
                <div 
                  class="absolute inset-0 w-full h-full bg-no-repeat opacity-0 group-hover:opacity-100 transition-opacity duration-500 z-0"
                  style="
                    background-image: url('${centerProject.imagenDestacada}');
                    background-size: 130%; 
                    background-position: center -140px;
                  "
                ></div>
              ` : ''}

              <div class="border-b border-stone-200 group-hover:border-stone-800 px-4 py-3 flex flex-wrap justify-end gap-1.5 transition-colors duration-300 group-hover:bg-stone-900/90 relative z-10">
                ${centerProject.categoria.map(cat => `
                  <span class="text-[9px] font-bold uppercase tracking-wider text-stone-700 group-hover:text-stone-300 border border-stone-300 group-hover:border-stone-700 bg-white/50 group-hover:bg-stone-800/80 rounded-md px-2 py-1 transition-colors duration-300">
                    ${cat}
                  </span>
                `).join('')}
              </div>

              <div class="w-60 h-60 mx-auto flex items-center justify-center md:-mt-10 md:-mb-10 -mb-10 -mt-5 relative z-10 transition-all duration-300 group-hover:opacity-0 group-hover:scale-95 group-hover:pointer-events-none">
                ${renderIlustracion(centerProject, true)}
              </div>

              <div class="px-4 py-3 flex flex-col gap-y-2 text-left relative z-10 transition-colors duration-300 group-hover:bg-stone-900/90">
                <span class="border-t border-stone-200 group-hover:border-stone-800 pt-1 px-3 text-sm font-semibold text-stone-900 group-hover:text-white transition-colors duration-300">
                  ${centerProject.titulo}
                </span>

                <span class="border-t border-stone-200 group-hover:border-stone-800 pt-1 px-3 text-[11px] text-stone-600 group-hover:text-stone-400 leading-relaxed line-clamp-2 transition-colors duration-300">
                  ${centerProject.subtituloBreve}
                </span>
              </div>

              <div class="border-t border-stone-200 group-hover:border-stone-800 pt-1 px-4 pt-3 pb-3 flex justify-center relative z-10 transition-colors duration-300 group-hover:bg-stone-900/90">
                <button id="btn-regar" type="button" class="inline-flex items-center gap-1.5 text-[11px] font-medium text-stone-900 group-hover:text-white border border-stone-300 group-hover:border-stone-700 bg-white/80 group-hover:bg-stone-800 rounded-md px-20 py-1.5 group-hover:hover:bg-[var(--color-accent)] group-hover:hover:border-[var(--color-accent)] transition-all duration-300 cursor-pointer">
                  regar
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M12 22c4.418 0 8-3.358 8-7.5 0-4.142-4-9.5-8-13.5-4 4-8 9.358-8 13.5C4 18.642 7.582 22 12 22Z"/>
                  </svg>
                </button>
              </div>

            </a>

          </div>
        </div>
      `;

      const btnRegar = document.getElementById('btn-regar');
      const cardLink = document.getElementById('card-center-link');

      if (btnRegar && cardLink) {
        btnRegar.addEventListener('click', (e) => {
          e.preventDefault();
          e.stopPropagation();

          // Redirección inmediata sin retardos
          window.location.href = cardLink.getAttribute('href');
        });
      }

      requestAnimationFrame(() => {
        ejecutarDemoMovil();
      });
    }

    // Slot 2 (Derecha)
    if (slot2) {
      slot2.innerHTML = `
        <a href="/proyectos/${rightProject.id}" class="slot-lateral-link group block cursor-pointer transition-transform duration-300 hover:scale-105">
          <div class="w-60 h-60 flex items-center justify-center">
            ${renderIlustracion(rightProject, false)}
          </div>
        </a>
      `;
    }

    // MANEJO DE CLIC EN LATERALES
    const linksLaterales = document.querySelectorAll('.slot-lateral-link');

    linksLaterales.forEach((link) => {
      link.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();

        const href = link.getAttribute('href');
        const spriteEl = link.querySelector('.planta-sprite');

        if (spriteEl) {
          // 1. Añadimos la clase .is-clicking para desactivar temporalmente el :hover
          spriteEl.classList.add('is-clicking');
          spriteEl.classList.remove('play-triggered');

          // 2. Forzamos reflow para reiniciar la animación CSS desde el frame 0
          void spriteEl.offsetWidth;

          // 3. Activamos la animación de clic
          spriteEl.classList.add('play-triggered');
        }

        // 4. Espera a que termine la animación (600ms) antes de redirigir
        setTimeout(() => {
          window.location.href = href;
        }, 600);
      });
    });

    renderDots();
  }

  // --- BOTONES PREV / NEXT ---
  if (btnPrev) {
    btnPrev.addEventListener('click', () => {
      currentIndex--;
      renderCarousel();
      resetAutoplay();
    });
  }

  if (btnNext) {
    btnNext.addEventListener('click', () => {
      currentIndex++;
      renderCarousel();
      resetAutoplay();
    });
  }

  // --- DETECCIÓN DE GESTOS SWIPE EN MÓVIL ---
  if (carruselContainer) {
    let startX = 0;
    let startY = 0;

    carruselContainer.addEventListener('touchstart', (e) => {
      startX = e.touches[0].clientX;
      startY = e.touches[0].clientY;
    }, { passive: true });

    carruselContainer.addEventListener('touchend', (e) => {
      const endX = e.changedTouches[0].clientX;
      const endY = e.changedTouches[0].clientY;
      const diffX = startX - endX;
      const diffY = startY - endY;

      if (Math.abs(diffX) > 40 && Math.abs(diffX) > Math.abs(diffY)) {
        if (diffX > 0) {
          currentIndex++;
        } else {
          currentIndex--;
        }
        renderCarousel();
        resetAutoplay();
      }
    }, { passive: true });
  }

  // --- TEMPORIZADOR AUTOMÁTICO ---
  function startAutoplay() {
    autoplayTimer = setInterval(() => {
      currentIndex++;
      renderCarousel();
    }, 9000);
  }

  function resetAutoplay() {
    clearInterval(autoplayTimer);
    startAutoplay();
  }

  function ejecutarDemoMovil() {
    const wrapper = document.getElementById('demo-card-wrapper');
    const cardLink = document.getElementById('card-center-link');

    if (!wrapper || !cardLink) return;

    setTimeout(() => {
      cardLink.classList.add('hover-simulated');
      wrapper.classList.add('is-demo-flipped');

      setTimeout(() => {
        wrapper.classList.remove('is-demo-flipped');
        setTimeout(() => {
          cardLink.classList.remove('hover-simulated');
        }, 300);
      }, 2000);

    }, 1500);
  }

  // --- GENERADOR DE SUELO ASCII ---
  function createAsciiGround({
    container,
    length = 110,
    speed = 150,
    charSets = { dense: '_', sparse: '.', empty: ' ' }
  } = {}) {
    const targetEl = typeof container === 'string' ? document.querySelector(container) : container;
    if (!targetEl) return () => {};

    const asciiEl = document.createElement('div');
    asciiEl.className = 'ascii-ground';
    targetEl.appendChild(asciiEl);

    let step = 0;

    function generateFrame() {
      let result = '';
      step += 0.12;

      for (let i = 0; i < length; i++) {
        const progress = i / (length - 1);
        const distanceToEdge = Math.abs(progress - 0.5) * 2;
        const densityMask = Math.pow(1 - distanceToEdge, 1.4);

        const wave = Math.sin(i * 0.1 - step);
        const noise = (Math.random() - 0.5) * 1.1;
        const signal = (wave + noise) * densityMask;

        if (Math.random() < 0.15) {
          result += charSets.empty;
        } else if (signal > 0.05) {
          result += charSets.dense;
        } else {
          result += charSets.sparse;
        }
      }

      asciiEl.textContent = result;
    }

    generateFrame();
    const intervalId = setInterval(generateFrame, speed);
    return () => { clearInterval(intervalId); asciiEl.remove(); };
  }

  // Inicialización
  renderCarousel();
  ejecutarDemoMovil(); 
  startAutoplay();
  createAsciiGround({
    container: '#ascii-ground-container',
    length: 110,
    speed: 750
  });
</script>