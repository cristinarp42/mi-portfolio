

<!-- Contenedor: maneja ÚNICAMENTE la posición del pico sobre el puntero -->
<div 
  id="custom-cursor" 
  class="fixed top-0 left-0 pointer-events-none z-50 transition-opacity duration-150 -translate-x-[20px] -translate-y-[60px] hidden md:block opacity-0 select-none"
>
  <!-- Imagen: maneja ÚNICAMENTE la animación de giro -->
  <img 
    src="/regadera-frame-02.svg" 
    alt="regadera" 
    class="regadera-img w-30 h-30"
  />
</div>

<style>
  /* Fijamos el eje de rotación exactamente en las coordenadas del pico */
  .regadera-img {
    transform-origin: 20px 60px;
  }

  /* Animación limpia: SOLO gira, sin tocar la posición X/Y */
  .regar-animacion {
    animation: inclinarRegadera 0.5s cubic-bezier(0.25, 1, 0.5, 1);
  }

  @keyframes inclinarRegadera {
    0% {
      transform: rotate(0deg);
    }
    35% {
      transform: rotate(-25deg); /* Se inclina hacia delante */
    }
    100% {
      transform: rotate(0deg); /* Vuelve al estado inicial */
    }
  }
</style>
<script>
const cursor = document.getElementById('custom-cursor');
  // Seleccionamos la imagen dentro del contenedor
  const regaderaImg = cursor.querySelector('.regadera-img'); 
  const heroZone = document.getElementById('hero-garden');

  if (cursor && heroZone && regaderaImg) {
    // ... (Mantenemos mouseenter, mouseleave y mousemove igual que los tienes) ...
    heroZone.addEventListener('mouseenter', () => {
      cursor.classList.remove('opacity-0');
      cursor.classList.add('opacity-100');
    });

    heroZone.addEventListener('mouseleave', () => {
      cursor.classList.remove('opacity-100');
      cursor.classList.add('opacity-0');
    });

    heroZone.addEventListener('mousemove', (e) => {
      cursor.style.left = `${e.clientX}px`;
      cursor.style.top = `${e.clientY}px`;
    });


    // --- MODIFICADO: Evento de clic con animación ---
    heroZone.addEventListener('click', (e) => {
      // 1. Disparar las gotas (mantenemos tu función)
      createWaterDrops(e.clientX, e.clientY);

      // 2. Activar la animación de inclinación
      // Primero quitamos la clase por si acaso ya estaba (para clics rápidos)
      regaderaImg.classList.remove('regar-animacion');
      
      // Forzamos un "reflow" para que el navegador reinicie la animación
      void regaderaImg.offsetWidth; 
      
      // Añadimos la clase para empezar la animación
      regaderaImg.classList.add('regar-animacion');
    });

    // Opcional: Limpiar la clase cuando acabe la animación (buena práctica)
    regaderaImg.addEventListener('animationend', () => {
      regaderaImg.classList.remove('regar-animacion');
    });
  }


  function createWaterDrops(x: number, y: number) {
    const dropCount = 6;
    for (let i = 0; i < dropCount; i++) {
      const drop = document.createElement('div');
      drop.className = 'fixed pointer-events-none rounded-full bg-sky-400 opacity-80 z-40';
      
      const size = Math.random() * 6 + 4;
      drop.style.width = `${size}px`;
      drop.style.height = `${size}px`;
      drop.style.left = `${x}px`;
      drop.style.top = `${y}px`;

      document.body.appendChild(drop);

      const destinationX = x + (Math.random() - 0.5) * 40;
      const destinationY = y + Math.random() * 50 + 20;

      const animation = drop.animate([
        { transform: 'translate(0, 0) scale(1)', opacity: 0.8 },
        { transform: `translate(${destinationX - x}px, ${destinationY - y}px) scale(0)`, opacity: 0 }
      ], {
        duration: 500 + Math.random() * 200,
        easing: 'cubic-bezier(0.25, 1, 0.5, 1)'
      });

      animation.onfinish = () => drop.remove();
    }
  }
</script>