---
import '../styles/global.css';
import RegaderaCursor from '../components/RegadoraCursor.astro';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content="Portfolio - Jardín Digital" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body class="bg-[#fafafa] text-slate-900 min-h-screen antialiased selection:bg-amber-200">
  <RegaderaCursor />
    <slot />
  </body>
</html>