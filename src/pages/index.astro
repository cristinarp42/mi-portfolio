---
import Layout from '../layout/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import JardinCarrusel from '../components/JardinCarrusel.astro';
---

<Layout title="Portfolio | Jardín Digital">
  <!-- Permite scroll libre en móvil (min-h-screen) y bloquea altura fija solo en escritorio (md:h-screen md:overflow-hidden) -->
  <div class="min-h-screen md:h-screen md:overflow-hidden flex flex-col">

    <Header />

    <!-- Área interactiva con paddings amplios en móvil (py-12) para más aire -->
    <main
      id="hero-garden"
      class="flex-1 w-full max-w-5xl mx-auto px-8 sm:px-8 py-12 sm:py-6 flex flex-col items-center justify-between sm:cursor-none overflow-visible md:overflow-hidden"
    >
      <!-- Cabecera alineada a la izquierda en móvil y centrada en desktop -->
      <header class="flex flex-col items-start md:items-center gap-2 my-auto select-none w-full">
        <h1 class="text-3xl sm:text-2xl font-bold tracking-tighter text-left md:text-center max-w-lg leading-tight">
          Hola, estás en mi huerto.
        </h1>
        <h2 class="text-lg sm:text-base tracking-tight text-left md:text-center max-w-md leading-normal text-stone-500">
          Cada plantita es un proyecto. Riégala para descubrirlo.
        </h2>
      </header>

      <!-- Contenedor del Carrusel con margen vertical adicional en móvil -->
      <div class="w-full flex-1 flex items-center justify-center my-6 md:my-auto">
        <JardinCarrusel />
      </div>
    </main>

    <Footer />

  </div>
</Layout>