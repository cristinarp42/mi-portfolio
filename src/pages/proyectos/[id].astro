---
import { getCollection, render } from 'astro:content';
import Layout from '../../layout/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

export async function getStaticPaths() {
  const proyectos = await getCollection('proyectos');
  return proyectos.map((proyecto) => ({
    params: { id: proyecto.id },
    props: { proyecto },
  }));
}

const { proyecto } = Astro.props;
const { Content } = await render(proyecto);
const { data } = proyecto;

// Preparamos la galería o una imagen destacada como fallback
const galeria = data.galeriaImagenes && data.galeriaImagenes.length > 0 
  ? data.galeriaImagenes 
  : (data.imagenDestacada ? [data.imagenDestacada] : []);

const primeraMedia = galeria[0] || '';
const esVideoInicial = /\.(mp4|webm|ogg|mov)(\?.*)?$/i.test(primeraMedia.trim());
---

<Layout title={`${data.titulo} | Proyecto`}>
  <div class="flex min-h-screen flex-col justify-between overflow-x-hidden">

    <Header />

    <main class="flex flex-1 w-full flex-col justify-center px-4 pb-12 pt-5 md:py-8 sm:px-8">
      <div class="mx-auto flex w-full max-w-7xl flex-col gap-6 md:gap-8">

        <!-- CABECERA DEL PROYECTO -->
        <div class="flex flex-col justify-between gap-4 pb-3 pt-1 sm:flex-row sm:items-center">

          <div class="flex min-w-0 flex-wrap items-center gap-3">
            <a 
              href="/" 
              class="inline-flex flex-none items-center gap-1.5 text-xs font-bold uppercase tracking-wider text-gray-400 transition-colors hover:text-black"
            >
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <line x1="19" y1="12" x2="5" y2="12"></line>
                <polyline points="12 19 5 12 12 5"></polyline>
              </svg>
              Volver al huerto
            </a>

            <span class="flex-none text-gray-300">/</span>

            <h1 class="truncate text-xl font-semibold tracking-tight text-[var(--color-accent)] md:text-3xl lg:text-4xl">
              {data.titulo}
            </h1>
          </div>

          <div class="flex flex-none flex-wrap items-center gap-1.5">
            {data.categoria.map((cat) => (
              <span class="inline-flex flex-none rounded-md border border-gray-300 px-2.5 py-1 text-[10px] font-bold uppercase tracking-wider">
                {cat}
              </span>
            ))}
          </div>

        </div>

        <!-- 2 COLUMNAS PRINCIPALES -->
        <div class="grid grid-cols-1 items-end gap-10 md:grid-cols-12 md:gap-12">

          <!-- COLUMNA IZQUIERDA: Galería / Imagen / Vídeo Principal -->
          <div class="flex w-full flex-col justify-end md:col-span-5">
            <div id="galeria-container" class="group relative aspect-[4/3] w-full touch-pan-y overflow-hidden rounded-xl border border-stone-200/80 bg-gray-50 shadow-sm">
              
              <!-- Botón Audio (Mute / Unmute) para Vídeos -->
              <button
                id="btn-toggle-audio"
                type="button"
                aria-label="Activar o desactivar sonido"
                class={`absolute right-3 top-3 z-40 h-9 w-9 items-center justify-center rounded-md border border-stone-200 bg-white/90 text-stone-700 shadow-sm backdrop-blur-sm transition-all cursor-pointer hover:border-black hover:bg-black hover:text-white ${esVideoInicial ? 'flex' : 'hidden'}`}
              >
                <!-- Icono Muted -->
                <svg id="icon-muted" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M11 5L6 9H2v6h4l5 4V5z"/>
                  <line x1="23" y1="9" x2="17" y2="15"/>
                  <line x1="17" y1="9" x2="23" y2="15"/>
                </svg>
                <!-- Icono Unmuted -->
                <svg id="icon-unmuted" class="hidden" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"/>
                  <path d="M19.07 4.93a10 10 0 0 1 0 14.14M15.54 8.46a5 5 0 0 1 0 7.07"/>
                </svg>
              </button>

              <!-- Wrapper para IMG / VIDEO -->
              <div id="media-wrapper" class="h-full w-full transition-opacity duration-300">
                {esVideoInicial ? (
                  <video
                    id="proyecto-media-principal"
                    src={primeraMedia}
                    autoplay
                    loop
                    muted
                    playsinline
                    webkit-playsinline
                    class="h-full w-full select-none object-cover"
                  ></video>
                ) : (
                  <img
                    id="proyecto-media-principal"
                    src={primeraMedia}
                    alt={data.titulo}
                    class="h-full w-full select-none object-cover"
                  />
                )}
              </div>

              {galeria.length > 1 && (
                <>
                  <button
                    id="btn-prev-img"
                    aria-label="Anterior"
                    class="absolute left-3 top-1/2 z-40 hidden h-10 w-10 -translate-y-1/2 cursor-pointer items-center justify-center rounded-md border border-stone-300 bg-white/90 text-stone-700 shadow-sm opacity-0 backdrop-blur-sm transition-colors group-hover:opacity-100 hover:border-[var(--color-accent)] hover:bg-[var(--color-accent)] hover:text-white md:flex"
                  >
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M15 18l-6-6 6-6"/>
                    </svg>
                  </button>

                  <button
                    id="btn-next-img"
                    aria-label="Siguiente"
                    class="absolute right-3 top-1/2 z-40 hidden h-10 w-10 -translate-y-1/2 cursor-pointer items-center justify-center rounded-md border border-stone-300 bg-white/90 text-stone-700 shadow-sm opacity-0 backdrop-blur-sm transition-colors group-hover:opacity-100 hover:border-[var(--color-accent)] hover:bg-[var(--color-accent)] hover:text-white md:flex"
                  >
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M9 18l6-6-6-6"/>
                    </svg>
                  </button>
                </>
              )}
            </div>

            <!-- Indicadores Paginación -->
            {galeria.length > 1 && (
              <div id="galeria-dots" class="mt-4 flex items-center justify-center gap-2">
                {galeria.map((_, i) => (
                  <button
                    type="button"
                    data-index={i}
                    aria-label={`Ver elemento ${i + 1}`}
                    class={`dot-btn h-2 cursor-pointer rounded-full transition-all ${i === 0 ? 'w-5 bg-black' : 'w-2 bg-gray-300 hover:bg-gray-400'}`}
                  ></button>
                ))}
              </div>
            )}
          </div>

          <!-- COLUMNA DERECHA: Pestañas + Acordeón -->
          <div class="mb-4 flex w-full min-w-0 flex-col justify-between self-stretch md:mb-0 md:col-span-7">

            <!-- Pestañas y Descripción -->
            <div class="w-full">
              {data.secciones && (
                <div id="tabs-container" class="w-full">
                  <nav class="flex gap-4 overflow-x-auto pb-2 text-xs font-bold sm:gap-5 sm:text-sm">
                    {data.secciones.encargo && (
                      <button data-tab="encargo" class="tab-btn cursor-pointer whitespace-nowrap border-b-2 border-black pb-2 text-black transition-all">
                        El encargo -
                      </button>
                    )}
                    {data.secciones.estrategia && (
                      <button data-tab="estrategia" class="tab-btn cursor-pointer whitespace-nowrap border-b-2 border-transparent pb-2 text-gray-400 transition-all hover:text-black">
                        La estrategia +
                      </button>
                    )}
                    {data.secciones.resultado && (
                      <button data-tab="resultado" class="tab-btn cursor-pointer whitespace-nowrap border-b-2 border-transparent pb-2 text-gray-400 transition-all hover:text-black">
                        El resultado +
                      </button>
                    )}
                  </nav>
                  <div class="-mt-[1px] border-b border-gray-200"></div>
                </div>
              )}

              <!-- Contenido Pestañas -->
              {data.secciones && (
                <div class="mb-8 mt-4 w-full text-sm leading-relaxed text-gray-500 md:mb-4 md:mt-6">
                  {data.secciones.encargo && (
                    <div id="tab-encargo" class="tab-content block">
                      <p set:html={data.secciones.encargo}></p>
                    </div>
                  )}
                  {data.secciones.estrategia && (
                    <div id="tab-estrategia" class="tab-content hidden">
                      <p set:html={data.secciones.estrategia}></p>
                    </div>
                  )}
                  {data.secciones.resultado && (
                    <div id="tab-resultado" class="tab-content hidden">
                      <p set:html={data.secciones.resultado}></p>
                    </div>
                  )}
                </div>
              )}
            </div>

            <!-- Acordeón de Detalles -->
            {data.detalles && data.detalles.length > 0 && (
              <div class="mt-10 w-full md:mt-8">
                <div class="flex min-h-[120px] w-full items-end justify-between gap-2 border-b border-gray-200 pb-0 sm:gap-4 md:min-h-[140px] md:gap-6">
                  {data.detalles.map((detalle, index) => {
                    const isOpen = index === 0;
                    return (
                      <div
                        data-index={index}
                        class={`detalle-item flex flex-col justify-between min-w-0 transition-all duration-300 ${isOpen ? 'flex-1' : 'w-16 sm:w-20 md:w-24'}`}
                      >
                        <div class="mb-3 flex items-start gap-2 sm:gap-3">
                          <button
                            data-index={index}
                            aria-label={`Ver detalle ${detalle.titulo}`}
                            class="accordion-trigger h-16 w-16 flex-none cursor-pointer overflow-hidden rounded-lg border border-gray-200 bg-gray-100 transition-colors hover:border-black sm:h-20 sm:w-20 md:h-24 md:w-24"
                          >
                            <img src={detalle.imagen} alt={detalle.titulo} class="pointer-events-none h-full w-full object-cover" />
                          </button>

                          <div class={`info-box min-w-0 text-xs text-gray-600 transition-opacity duration-200 md:text-sm ${isOpen ? 'block opacity-100' : 'hidden opacity-0'}`}>
                            <p 
                              class="leading-relaxed line-clamp-3 sm:line-clamp-4" 
                              set:html={detalle.descripcion}
                            />
                          </div>
                        </div>

                        <button
                          data-index={index}
                          class={`accordion-trigger group flex w-full cursor-pointer items-center justify-between border-b-2 pb-2.5 -mb-[1px] text-left text-[11px] font-bold transition-all sm:text-xs md:text-sm ${
                            isOpen
                              ? 'border-black text-black'
                              : 'border-transparent text-gray-400 hover:border-black hover:text-black'
                          }`}
                        >
                          <span class="title-text truncate">
                            {detalle.titulo}
                          </span>
                          <span class="symbol ml-1 flex-none font-mono text-xs md:text-sm">
                            {isOpen ? '-' : '+'}
                          </span>
                        </button>
                      </div>
                    );
                  })}
                </div>
              </div>
            )}

          </div>

        </div>

      </div>
    </main>

    <Footer class="px-4 py-12 sm:px-8 md:py-8" />
  </div>
</Layout>

<script define:vars={{ galeriaImagenes: galeria, tituloProyecto: data.titulo }}>
  const mediaWrapper = document.getElementById('media-wrapper');
  const dots = document.querySelectorAll('.dot-btn');
  const btnPrev = document.getElementById('btn-prev-img');
  const btnNext = document.getElementById('btn-next-img');
  const galeriaContainer = document.getElementById('galeria-container');
  const btnAudio = document.getElementById('btn-toggle-audio');
  const iconMuted = document.getElementById('icon-muted');
  const iconUnmuted = document.getElementById('icon-unmuted');

  let currentIndex = 0;
  let isAudioMuted = true;

  function isVideo(url) {
    return typeof url === 'string' && /\.(mp4|webm|ogg|mov)(\?.*)?$/i.test(url.trim());
  }

  function updateAudioButtonUI() {
    if (isAudioMuted) {
      iconMuted?.classList.remove('hidden');
      iconUnmuted?.classList.add('hidden');
    } else {
      iconMuted?.classList.add('hidden');
      iconUnmuted?.classList.remove('hidden');
    }
  }

  function toggleAudio() {
    const video = mediaWrapper?.querySelector('video');
    if (video) {
      isAudioMuted = !isAudioMuted;
      video.muted = isAudioMuted;
      updateAudioButtonUI();
    }
  }

  btnAudio?.addEventListener('click', toggleAudio);

  function updateMedia(newIndex) {
    if (!mediaWrapper || galeriaImagenes.length === 0) return;
    
    if (newIndex < 0) currentIndex = galeriaImagenes.length - 1;
    else if (newIndex >= galeriaImagenes.length) currentIndex = 0;
    else currentIndex = newIndex;

    const newSrc = galeriaImagenes[currentIndex];
    const isVid = isVideo(newSrc);

    if (btnAudio) {
      if (isVid) {
        btnAudio.classList.remove('hidden');
        btnAudio.classList.add('flex');
      } else {
        btnAudio.classList.remove('flex');
        btnAudio.classList.add('hidden');
      }
    }

    mediaWrapper.style.opacity = '0';

    setTimeout(() => {
      mediaWrapper.innerHTML = '';

      if (isVid) {
        const video = document.createElement('video');
        video.id = 'proyecto-media-principal';
        video.src = newSrc;
        video.autoplay = true;
        video.loop = true;
        video.muted = isAudioMuted;
        video.playsInline = true;
        video.className = 'h-full w-full select-none object-cover';
        
        mediaWrapper.appendChild(video);
        video.play().catch(() => {});
      } else {
        const img = document.createElement('img');
        img.id = 'proyecto-media-principal';
        img.src = newSrc;
        img.alt = tituloProyecto || 'Proyecto';
        img.className = 'h-full w-full select-none object-cover';
        
        mediaWrapper.appendChild(img);
      }

      mediaWrapper.style.opacity = '1';
    }, 150);

    dots.forEach((d, i) => {
      if (i === currentIndex) {
        d.classList.remove('bg-gray-300', 'hover:bg-gray-400', 'w-2');
        d.classList.add('bg-black', 'w-5');
      } else {
        d.classList.remove('bg-black', 'w-5');
        d.classList.add('bg-gray-300', 'w-2');
      }
    });
  }

  btnPrev?.addEventListener('click', () => updateMedia(currentIndex - 1));
  btnNext?.addEventListener('click', () => updateMedia(currentIndex + 1));

  dots.forEach((dot) => {
    dot.addEventListener('click', () => {
      const idx = parseInt(dot.getAttribute('data-index') || '0', 10);
      updateMedia(idx);
    });
  });

  if (galeriaContainer && galeriaImagenes.length > 1) {
    let startX = 0;
    let endX = 0;

    galeriaContainer.addEventListener('touchstart', (e) => {
      startX = e.touches[0].clientX;
    }, { passive: true });

    galeriaContainer.addEventListener('touchend', (e) => {
      endX = e.changedTouches[0].clientX;
      const threshold = 40;
      const diff = startX - endX;

      if (Math.abs(diff) > threshold) {
        if (diff > 0) updateMedia(currentIndex + 1);
        else updateMedia(currentIndex - 1);
      }
    }, { passive: true });
  }
</script>

<script>
  // Script para Pestañas y Acordeón
  const buttons = document.querySelectorAll('.tab-btn');
  const contents = document.querySelectorAll('.tab-content');

  buttons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const target = btn.getAttribute('data-tab');

      buttons.forEach((b) => {
        b.classList.remove('border-black', 'text-black');
        b.classList.add('border-transparent', 'text-gray-400');
        b.textContent = b.textContent?.replace('-', '+') || '';
      });

      btn.classList.remove('border-transparent', 'text-gray-400');
      btn.classList.add('border-black', 'text-black');
      btn.textContent = btn.textContent?.replace('+', '-') || '';

      contents.forEach((content) => {
        if (content.id === `tab-${target}`) {
          content.classList.remove('hidden');
          content.classList.add('block');
        } else {
          content.classList.remove('block');
          content.classList.add('hidden');
        }
      });
    });
  });

  const items = document.querySelectorAll('.detalle-item');
  const triggers = document.querySelectorAll('.accordion-trigger');

  triggers.forEach((trigger) => {
    trigger.addEventListener('click', () => {
      const targetIndex = trigger.getAttribute('data-index');

      items.forEach((item) => {
        const itemIndex = item.getAttribute('data-index');
        const infoBox = item.querySelector('.info-box');
        const accordionBtn = item.querySelector('button.border-b-2');
        const symbol = item.querySelector('.symbol');

        if (itemIndex === targetIndex) {
          item.classList.remove('w-16', 'sm:w-20', 'md:w-24');
          item.classList.add('flex-1');

          if (infoBox) {
            infoBox.classList.remove('hidden');
            setTimeout(() => infoBox.classList.add('opacity-100'), 10);
          }
          if (accordionBtn) {
            accordionBtn.classList.remove('border-transparent', 'text-gray-400');
            accordionBtn.classList.add('border-black', 'text-black');
          }
          if (symbol) symbol.textContent = '-';
        } else {
          item.classList.remove('flex-1');
          item.classList.add('w-16', 'sm:w-20', 'md:w-24');

          if (infoBox) {
            infoBox.classList.remove('opacity-100');
            infoBox.classList.add('hidden');
          }
          if (accordionBtn) {
            accordionBtn.classList.remove('border-black', 'text-black');
            accordionBtn.classList.add('border-transparent', 'text-gray-400');
          }
          if (symbol) symbol.textContent = '+';
        }
      });
    });
  });
</script>